# ===================================================================
# PROJECT AURA — ENVIRONMENT CONFIGURATION
# Free and Open-Source AI Girlfriend WhatsApp Bot
# ===================================================================

# Application
APP_NAME="Project AURA"
DEBUG=false
PORT=8000
HOST="0.0.0.0"
BASE_URL="http://localhost:8000"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_aura_2026"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="aura2026_change_me"

# -------------------------------------------------------------------
# WhatsApp Business Cloud API (Official Meta Graph API)
# Get credentials from developers.facebook.com -> WhatsApp -> API Setup
# Note: Incoming user-initiated conversations have 1,000 free per month
# -------------------------------------------------------------------
WHATSAPP_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_BUSINESS_ACCOUNT_ID="1234567890"
WHATSAPP_VERIFY_TOKEN="aura_verify_token_2026"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"

# -------------------------------------------------------------------
# AI LLM Providers (Free Tiers & Open-Source Supported)
# -------------------------------------------------------------------
PRIMARY_AI_PROVIDER="groq"          # Options: "groq", "gemini", "ollama", "openrouter"
FALLBACK_AI_PROVIDERS=["gemini","ollama","openrouter"]

# Groq (Free tier available at console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini API (Free tier available at aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Ollama Local Offline AI (100% Free, zero cloud dependence)
# Install from ollama.ai and run: ollama run llama3
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:latest"

# OpenRouter Free Models (openrouter.ai)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Custom / Dedicated External AI API (DeepSeek, Together.ai, Mistral, Anyscale, LM Studio, etc.)
# If you want to use your own private API or key:
CUSTOM_AI_API_KEY=""
CUSTOM_AI_BASE_URL="https://api.openai.com/v1"
CUSTOM_AI_MODEL="gpt-4o-mini"

# -------------------------------------------------------------------
# Voice Configuration (Microsoft Edge-TTS — 100% Free, No Key Required)
# -------------------------------------------------------------------
TTS_DEFAULT_VOICE_URDU="ur-PK-UzmaNeural"
TTS_DEFAULT_VOICE_ENGLISH="en-US-AvaNeural"
TTS_DEFAULT_VOICE_HINGLISH="hi-IN-SwaraNeural"
TTS_RATE="+0%"
TTS_PITCH="+0Hz"

# Whisper Speech-to-Text (Local Faster-Whisper, runs on CPU/GPU free)
WHISPER_MODEL_SIZE="base"            # Options: "tiny", "base", "small"
WHISPER_DEVICE="cpu"                # Options: "cpu", "cuda"

# -------------------------------------------------------------------
# Image Generation & Identity Consistency (Pollinations / Flux / SD)
# -------------------------------------------------------------------
IMAGE_PROVIDER="pollinations"        # Options: "pollinations", "local_sd"
IMAGE_MODEL="flux"
IMAGE_SEED=789234
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024

# -------------------------------------------------------------------
# Proactive Automated Greetings & Check-ins
# -------------------------------------------------------------------
PROACTIVE_MESSAGING_ENABLED=true
PROACTIVE_MORNING_HOUR=9             # 9:00 AM
PROACTIVE_NIGHT_HOUR=23              # 11:00 PM
